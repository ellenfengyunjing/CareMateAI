{
  "name": "ai-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"next dev\" \"tsx server/index.ts\"",
    "dev:web": "next dev",
    "dev:api": "tsx server/index.ts",
    "build": "next build && tsc -p tsconfig.server.json",
    "typecheck:api": "tsc -p tsconfig.server.json",
    "start": "concurrently \"next start\" \"tsx server/index.ts\"",
    "preview": "next start"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "axios": "^1.16.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "openai": "^6.39.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2"
  }
}
